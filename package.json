{
  "name": "sesion-de-poker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:archivo": "tsc -b && vite build --mode archivo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "iconos": "node scripts/generar-iconos.mjs",
    "apk:preparar": "node scripts/generar-iconos.mjs && npx @capacitor/assets generate --android",
    "apk:sync": "npm run build && npx cap sync android",
    "check": "tsc -b && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
